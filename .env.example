NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# SQLite file path (relative to process.cwd() unless absolute)
SQLITE_PATH=./data/app.db

# Signup policy (optional)
MIN_SIGNUP_AGE=13
MAX_SIGNUP_AGE=120
SIGNUP_PASSWORD_MIN_LEN=12
SIGNUP_PASSWORD_MAX_LEN=128
ZXCVBN_MIN_SCORE=3
HIBP_USER_AGENT=api-rest-node-signup

# JWT/Auth (required for token-based auth)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_COOKIE_MAX_AGE_MS=900000
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

# MinIO (S3-compatible) for optional event images — required if POST /events includes an image
# From Docker Compose, use the internal service URL; from the host machine use http://localhost:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=events
MINIO_REGION=us-east-1
